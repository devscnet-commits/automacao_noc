# Copie para .env (que NÃO é versionado) e preencha. Em produção, prefira injetar
# estas variáveis pelo systemd (EnvironmentFile com permissão 600) em vez de um .env.
# Nenhum destes valores pode ir para o código, para o banco ou para log.

# --- Banco de dados ---------------------------------------------------------
# Lido pelo dbmate (migrações) e pela aplicação. A senha precisa ser a mesma do
# secret do PostgreSQL definido no docker-compose.
DATABASE_URL=postgres://noc:TROCAR@127.0.0.1:5432/noc?sslmode=disable

# --- MK ERP -----------------------------------------------------------------
# URL base, sem /mk no final (o cliente monta /mk/<Servico>.rule).
MK_BASE_URL=https://mk.exemplo.invalid
MK_TOKEN_USUARIO=
MK_CONTRA_SENHA=

# --- OLTs (somente leitura) -------------------------------------------------
# PENDENTE: validar com NOC/bancada se o SNMP é v2c ou v3 e se a credencial é
# única para todas as OLTs ou uma por OLT. As variáveis abaixo são provisórias.
OLT_SNMP_COMMUNITY=
OLT_SSH_USUARIO=
OLT_SSH_SENHA=

# --- Aplicação --------------------------------------------------------------
LOG_LEVEL=INFO
