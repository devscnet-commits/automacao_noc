# Copie para .env (que NÃO é versionado) e preencha. Em produção, prefira injetar
# estas variáveis pelo systemd (EnvironmentFile com permissão 600) em vez de um .env.
# Nenhum destes valores pode ir para o código, para o banco ou para log.
#
# Padrão de nomes: tudo com prefixo NOC_, exceto DATABASE_URL (nome fixo do dbmate).

# --- Banco de dados ---------------------------------------------------------
# Aplicação: conecta SEMPRE como noc_app, com NOC_DB_* + a senha lida do arquivo.
# Ela não lê a DATABASE_URL. No container, o docker-compose já define estas;
# para rodar a aplicação no host, descomente com NOC_DB_HOST=127.0.0.1 e
# NOC_DB_PASSWORD_FILE=secrets/noc_app_password.txt.
# NOC_DB_HOST=db
# NOC_DB_PORTA=5432
# NOC_DB_USUARIO=noc_app
# NOC_DB_NOME=noc
# NOC_DB_PASSWORD_FILE=/run/secrets/noc_app_password

# dbmate (migrações, só no host): usa o noc, dono das tabelas e superusuário.
# A senha é a mesma de secrets/postgres_password.txt.
DATABASE_URL=postgres://noc:TROCAR@127.0.0.1:5432/noc?sslmode=disable
# O dbmate não gera db/schema.sql: isso exigiria pg_dump 16 instalado no host.
DBMATE_NO_DUMP_SCHEMA=true

# --- MK ERP -----------------------------------------------------------------
# Opcionais: a coleta das OLTs roda sem elas; o cliente MK acusa a falta ao ser usado.
# URL base, sem /mk no final (o cliente monta /mk/<Servico>.rule). Ex.: https://mk.seudominio
NOC_MK_BASE_URL=
NOC_MK_TOKEN_USUARIO=
NOC_MK_CONTRA_SENHA=
# PENDENTE: validar com NOC/bancada. Só se o MK usar certificado próprio: caminho do
# bundle (PEM) da CA dele. A verificação de certificado nunca é desligada.
NOC_MK_CA_BUNDLE=

# --- OLTs (somente leitura): padrão global ----------------------------------
# PENDENTE: validar com NOC/bancada a versão do SNMP e se a credencial é única
# ou por OLT. Valores provisórios. Só v2c está previsto para implementação agora.
NOC_OLT_SNMP_VERSAO=v2c
NOC_OLT_SNMP_COMMUNITY=
NOC_OLT_SSH_USUARIO=
NOC_OLT_SSH_SENHA=

# PENDENTE: validar com NOC/bancada. SNMPv3 NÃO está implementado; o formato
# abaixo fica reservado (e vale também dentro de NOC_OLT_SOBRESCRITAS).
# NOC_OLT_SNMP_V3_USUARIO=
# NOC_OLT_SNMP_V3_AUTH_PROTOCOLO=
# NOC_OLT_SNMP_V3_AUTH_SENHA=
# NOC_OLT_SNMP_V3_PRIV_PROTOCOLO=
# NOC_OLT_SNMP_V3_PRIV_SENHA=

# --- OLTs: sobrescrita por OLT (opcional) -----------------------------------
# JSON indexado pelo nome da OLT (o mesmo nome cadastrado na tabela olts).
# Cada OLT pode sobrescrever qualquer campo do padrão global, usando os mesmos
# nomes em minúsculas e sem o prefixo NOC_OLT_; o que faltar vem do global.
# NOC_OLT_SOBRESCRITAS='{"NOME-DA-OLT": {"snmp_versao": "v2c", "snmp_community": "..."}}'

# --- Aplicação --------------------------------------------------------------
NOC_LOG_LEVEL=INFO
